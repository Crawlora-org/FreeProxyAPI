{
  "title": "FreeProxyAPI",
  "uid": "freeproxyapi",
  "tags": [
    "freeproxyapi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Validated",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_validated)",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stable (>=80% ratio)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_validated_stable)",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Candidates / Pending",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_candidates)",
          "refId": "A"
        },
        {
          "expr": "max(freeproxyapi_pending)",
          "refId": "B"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In-flight Probes (all replicas)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(freeproxyapi_inflight_probes)",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Due Now",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_pending_due)",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 4
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Next Due In (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_pending_next_due_in_seconds)",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 16,
        "y": 4
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Validated vs Pending",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "max(freeproxyapi_validated)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Probe outcomes by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(freeproxyapi_probe_results_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Claims rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(freeproxyapi_claims_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Budget denials & burst discards",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(freeproxyapi_budget_denials_total[10m]))",
          "refId": "A"
        },
        {
          "expr": "sum(rate(freeproxyapi_candidates_discarded_total[10m]))",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Lease reclaims & result conflicts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(freeproxyapi_lease_reclaims_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Source refreshes by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(freeproxyapi_source_refreshes_total[15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Validated by country (top 15)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(15, freeproxyapi_validated_by_country{country!=\"unknown\"})",
          "refId": "A"
        },
        {
          "expr": "freeproxyapi_validated_by_country{country=\"unknown\"}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Source feed failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(freeproxyapi_source_fetch_failures_by_reason_total[15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Validated by latency band",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (band) (freeproxyapi_validated_latency_band)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      }
    },
    {
      "id": 15,
      "type": "piechart",
      "title": "Anonymity class distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (class) (freeproxyapi_validated_by_anonymity)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 16,
      "type": "barchart",
      "title": "Validated by ASN (top 15)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(15, freeproxyapi_validated_by_asn{asn!=\"unknown\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "CPU usage (% of limit)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"freeproxyapi\",container=\"freeproxyapi\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"freeproxyapi\",container=\"freeproxyapi\",resource=\"cpu\",unit=\"core\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Memory usage (% of limit)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "targets": [
        {
          "expr": "100 * sum(container_memory_working_set_bytes{namespace=\"freeproxyapi\",container=\"freeproxyapi\"}) / sum(kube_pod_container_resource_limits{namespace=\"freeproxyapi\",container=\"freeproxyapi\",resource=\"memory\",unit=\"byte\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Monitor container restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"freeproxyapi\",container=\"freeproxyapi\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Probe success rate by target",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "100 * sum by (target) (rate(freeproxyapi_probe_results_by_target_total{outcome=\"ok\"}[10m])) / sum by (target) (rate(freeproxyapi_probe_results_by_target_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Probe p95 latency by target",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, target) (rate(freeproxyapi_probe_duration_seconds_bucket[10m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Probe failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(freeproxyapi_probe_outcomes_total{outcome=\"failed\"}[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Probe success rate: first check vs retest",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "expr": "100 * sum by (kind) (rate(freeproxyapi_probe_outcomes_total{outcome=\"ok\"}[10m])) / sum by (kind) (rate(freeproxyapi_probe_outcomes_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "HTTPS spot checks by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(freeproxyapi_https_probe_results_total[15m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "HTTPS spot-check pass rate (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(increase(freeproxyapi_https_probe_results_total{outcome=\"ok\"}[1h])) / sum(increase(freeproxyapi_https_probe_results_total[1h]))",
          "refId": "A"
        }
      ],
      "options": {},
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 64
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Anonymity classes over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "targets": [
        {
          "expr": "max by (class) (freeproxyapi_validated_by_anonymity)",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Echo tampering results",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(freeproxyapi_echo_tamper_results_total[15m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Internal API query failures (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "targets": [
        {
          "expr": "sum(increase(freeproxyapi_internal_api_query_failures_total[15m]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "gost-router available replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"freeproxyapi\",deployment=\"gost-router\"})",
          "legendFormat": "available",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "gost-router container restarts (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"freeproxyapi\",pod=~\"gost-router-.*\"}[15m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
